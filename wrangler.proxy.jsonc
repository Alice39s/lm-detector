{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lm-fingerpoint-proxy",
  "main": "api/proxy.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["enable_request_signal"],
  "routes": [{ "pattern": "lm.ikale.io/api/proxy", "zone_name": "ikale.io" }],
  "workers_dev": false,
  "preview_urls": false
}
