# Hashed files never change, so browsers may keep them for a year. This is safe only because 404.html exists:
# without it, Pages answers a missing file with index.html and status 200, and that HTML would be cached as the file.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/chunks/*
  Cache-Control: public, max-age=31536000, immutable

/docs/assets/*
  Cache-Control: public, max-age=31536000, immutable

/docs/api/search
  Content-Type: application/json; charset=utf-8
